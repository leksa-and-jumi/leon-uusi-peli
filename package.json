{
  "name": "leon-uusi-peli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Leo's new game / Leon uusi peli",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server && tsc --noEmit -p convex",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "deploy:rooms": "wrangler deploy --config server/wrangler.jsonc",
    "deploy:accounts": "convex deploy"
  },
  "dependencies": {
    "convex": "^1.49.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.3.0",
    "prettier": "^3.8.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22"
  }
}
